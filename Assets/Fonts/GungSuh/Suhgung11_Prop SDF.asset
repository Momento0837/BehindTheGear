    characterSetSelectionMode: 7
    characterSequence: "\uC5BC\uC528\uAD6C\xB7\xB7\xB7 \uD604\uC2E4 \uBD80\uC815\uC774\uB77C\uB3C4
      \uD558\uB294 \uAC70\uB2C8? \uADF8 \uACE0\uC9D1 \uC5B4\uB514\uAE4C\uC9C0 \uAC00\uB098
      \uBCF4\uC790\uAFB8\uB098.\r\n\r\n\uC545\uC5B4\uC758 \uB208\uBB3C\uC774\uB77C\uB3C4
      \uAD1C\uCC2E\uB2E4\uBA74 \uB124 \uC2DC\uCCB4 \uC55E\uC5D0\uC11C \uD55C \uBC29\uC6B8
      \uC815\uB3C4\uB294 \uD758\uB824\uC8FC\uACA0\uC5B4. \uD06C\uD750\uD750\xB7\xB7\xB7.\r\n\r\n\uBB3C\uB860
      \uB108\uB77C\uB294 \uC7AC\uBC0B\uAC70\uB9AC\uB97C \uBC14\uB85C \uB193\uC744
      \uC0DD\uAC01\uC740 \uC5C6\uB2E8\uB2E4. \uC0DD\uAC01\uC774 \uC788\uB2E4\uBA74
      \uB2E4\uC2DC \uB9D0 \uAC78\uC5B4, \uC548\uC4F0\uB7EC\uC6B4 \uAC83\xB7\xB7\xB7.\r\n\r\n\r\n\r\n\uAE08\uC0C8
      \uAC81\uC774\uB77C\uB3C4 \uBA39\uC740 \uAC8C\uB2C8? \uC544\uC774\uACE0, \uCC38
      \uC6C3\uAE30\uAD6C\uB098.\r\n\uADF8\uB807\uB2E4\uACE0 \uC774\uC0C1\uD55C \uC815\uBCF4\uB97C
      \uC904 \uAC74 \uC544\uB2C8\uC57C. \uAC71\uC815 \uB9D0\uB77C\uACE0\xB7\xB7\xB7\xB7\xB7\xB7.\r\n\r\n\uB108\uCC98\uB7FC
      \uC8FD\uC5B4\uAC00\uB294 \uB098\uC0AC \uD558\uB098 \uC8FC\uC6CC\uB2F4\uB294\uAC8C
      \uC5B4\uB514 \uD55C \uB450\uBC88\uCC98\uB7FC \uBCF4\uC774\uB0D0.\r\n\uB2E4\uB978
      \uAC83\uB4E4\uCC98\uB7FC \uAE08\uBC29 \uB3D9\uAC15\uB098\uC9C0 \uB9D0\uACE0
      \uC81C \uAC12\uC880 \uD574\uBCF4\uB77C\uB294 \uB9D0\uC774\uC57C.\r\n\uC751?
      \uBAB8\uC73C\uB85C \uAC1A\uB294\uAC8C \uC544\uB2C8\uB77C, \uC815\uBCF4\uB97C
      \uC880 \uAC00\uC838\uC640\uBCF4\uB77C\uB294 \uAC70\uC9C0.\r\n\r\n\uC6D0\uD558\uB294
      \uAC8C \uBB61\uB2C8\uAE4C?\r\n\uC81C\uAC00 \uB2F9\uC2E0\uC774 \uC6D0\uD558\uB294
      \uB9CC\uD07C \uADC0\uC911\uD55C \uC815\uBCF4\uB97C \uC904 \uC218 \uC788\uC744\uC9C0
      \uBBF8\uC9C0\uC218\uC778\uB370.\r\n\r\n\uAE00\uC384. \uC81C \uAC12 \uD558\uC9C0
      \uBABB\uD558\uBA74 \uAE08\uC0C8 \uC0AC\uB77C\uC838\uBC84\uB9AC\uB294\uAC8C
      \uC774 \uBC14\uB2E5\uC774\uC796\uB2C8.\r\n\uADF8\uB7EC\uB2C8 \uB300\uAC00 \uC5C6\uC774
      \uB3C4\uC640\uC8FC\uB294 \uC0AC\uB78C\uC740 \uB298 \uC870\uC2EC\uD574\uC57C\uC9C0\xB7\xB7\xB7.\r\n\uC190
      \uC7A1\uC740 \uAC74 \uB124\uAC00 \uBA3C\uC800\uB2C8 \uC774\uC81C \uC640 \uBE84
      \uC218 \uC5C6\uC5B4.\r\n\r\n\uB124\uAC00 \uC54C\uAC8C \uB41C \uC815\uBCF4\uB97C
      \uC2F8\uADF8\uB9AC \uAC00\uC838\uC624\uB834.\r\n\uC774 \uBC14\uB2E5\uC5D0\uC11C
      \uB3CC\uC544\uAC00\uB294 \uBAA8\uB4E0 \uC815\uBCF4\uB97C \uB098\uC5D0\uAC8C
      \uB4E4\uACE0 \uC640.\r\n\r\n\uADF8\uAC70\uBA74 \uB3FC! \uD0A4\uD788\uD788,
      \uC815\uB9D0\uC774\uC57C\xB7\xB7\xB7\xB7\xB7\xB7. \uB54C\uC5D0 \uB530\uB77C
      \uC815\uBCF4\uAC00 \uB3C8\uBCF4\uB2E4 \uB354 \uD070 \uBD80\uB97C \uAC00\uC9C0\uACE0
      \uC624\uAE30\uB3C4 \uD558\uC9C0\xB7\xB7\xB7.\r\n\r\n\uB0B4\uAC00 \uAC00\uC9C4
      \uC815\uBCF4\uB97C \uB3C8\uC73C\uB85C \uBC14\uAFD4 \uBA39\uC73C\uBA74- \uAD49\uC7A5\uD55C
      \uBD80\uB97C \uC5BB\uC744 \uC218 \uC788\uC744 \uD130\uC778\uB370\xB7\xB7\xB7.\r\n\uC544\uC774\uC57C,
      \uB0B4\uAC00 \uB300\uB2E8\uD574 \uBCF4\uC774\uC9C0 \uC54A\uB2C8? \uB108\uB294
      \uBD80\uB7FD\uC9C0\uB3C4 \uC54A\uC544?\r\n\r\n\xB7\xB7\xB7\xB7\xB7\xB7\uC774\uB534
      \uCC98\uC9C0\uC5D0 \uB2F9\uC2E0\uC744 \uBD80\uB7EC\uC6CC \uD560\uB9AC \uC788\uACA0\uC2B5\uB2C8\uAE4C.\r\n\r\n\uAE09\uD788
      \uCAD3\uAE30\uB294 \uC785\uC7A5\uC774\uB2C8 \uBCF8\uB860\uB9CC \uBE68\uB9AC
      \uB9D0\uD558\uC2DC\uAE38.\r\n\r\n\uADF8\uB798 \uC5BC\uB978 \uBCF8\uB860\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uBCFC\uAE4C. \uC7AC\uBC0B\uAC70\uB9AC\uB97C \uB193\uCE60
      \uC218 \uC5C6\uB294 \uB178\uB987\uC774\uB2C8.\r\n\uC800 \uC5B4\uB514 \uC232\uAC00\uC5D0
      \uBC14\uBCF4\uAC19\uC740 \uC5EC\uC790 \uD558\uB098 \uB3CC\uC544\uB2E4\uB2C8\uB358\uB370,
      \uB108\uCC98\uB7FC \uBAA9\uC801\uC774 \uAC19\uC544 \uBCF4\uC5EC.\r\n\r\n\uC774\uB97C\uD14C\uBA74
      '\uBC18\uB3D9\uBD84\uC790?'\r\n\uD06C\uD750, \uD750\uD750\xB7\xB7\xB7 \uC7AC\uBC0C\uC5B4,
      \uC544\uC8FC \uC7AC\uBC0C\uACA0\uAD6C\uB098.\r\n\r\n\uAC71\uC815\uB9C8\xB7\xB7\xB7
      \uC544\uBB34 \uB370\uC5D0\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC744 \uAC70\uB780\uB2E4.\r\n\uB0B4\uAC00
      \uB110 \uB3D5\uB294 \uAC83\uC740 \uC21C\uC804\uD788 \uC7AC\uBC0C\uC73C\uB824\uACE0
      \uADF8\uB7EC\uB294 \uAC70\uAC70\uB4E0.\r\n\uADF8\uB7EC\uB2E4 \uC8FD\uC5B4\uB3C4
      \uB0B4 \uC54C \uBC14 \uC544\uB2C8\uB77C\uB294 \uB9D0\uC774\uC9C0.\r\n\r\n\uC544\uB2C8,
      \uC560\uCD08\uC5D0 \uB124\uAC00 \uC0B4\uC544\uB0A8\uC744 \uAC00\uC815\uC870\uCC28
      \uD558\uC9C0 \uC54A\uC558\uC5B4! \uC5B4\uB514 \uD55C \uBC88 \uC0B4\uC544\uB0A8\uB358\uAC00.\r\n\r\n\uC544\uCC28\uCC28,
      \uD639\uC2DC \uBAB0\uB77C \uC77C\uB7EC\uB450\uB294\uB370 \uB0B4 \uB4A4\uD1B5\uC218\uB294
      \uCE58\uC9C0 \uC54A\uB294 \uAC83\uC774 \uC88B\uC744 \uAC70\uC57C.\r\n\r\n\uC800
      \uB192\uC73C\uC2E0 \uBD84\uB4E4\uB3C4 \uB0B4 \uC55E\uC5D0\uC120 \uBB34\uB98E\uC744
      \uAFC7\uACE0, \uB1CC\uBB3C\uC744 \uB300\uB839\uD574\uC57C \uD560 \uAC70\uC57C.
      \uB108\uB294- \uC544\uB9C8 \uAC00\uC9C4 \uAC83\uC774 \uC5C6\uC73C\uB2C8 \uC950\uC0C8\uB07C
      \uAC19\uC740 \uBAA9\uC228\uC744 \uB0A0\uB9AC\uAC8C \uB418\uACA0\uC9C0\xB7\xB7\xB7.\r\n\r\n\uC80A\uC740
      \uC774\uC758 \uC7A5\uAE30\uB294 \uC88B\uC740 \uAC70\uB798 \uC218\uB2E8\uC774
      \uB418\uB2C8\uAE4C\xB7\xB7\xB7. \uD06D\uD06C.\r\n\xB7\xB7\xB7\uADF8\uB7EC\uB2C8
      \uC0B4\uAC8C \uB418\uBA74 \uB098\uC911\uC5D0 \uB0B4 \uC740\uD61C \uC78A\uC9C0
      \uB9D0\uACE0 \uAF2D \uAC1A\uC73C\uB77C\uACE0. '\uC774\uB4E0'.\r\n\r\n\xB7\xB7\xB7\xB7\xB7\xB7\uC9C0\uB3C5\uD55C
      \uC0AC\uB78C\uC774\uC2DC\uAD70\uC694.\r\n\r\n\uC608, \uC774\uB807\uAC8C \uB41C
      \uAC70 \uC0B4\uC544\uC11C \uBD59\uC8E0.\r\n\r\n\uD06D\uD06C, \uC774\uB7F0 \uC774\uB7F0\xB7\xB7\xB7.
      \uC544\uC8FC \uB300\uCC28\uAC8C \uCAD3\uAE30\uB294 \uC2E0\uC138\uAC00 \uB418\uC5C8\uAD6C\uB098
      \uC598\uC57C.\r\n\uB6F0\uC5B4 \uB098\uC640\uC11C \uAE30\uAECF \uC628 \uACF3\uC774
      \uC2DC\uC7A5\uC774\uB77C\uB2C8. \uBC14\uBCF4 \uAC19\uAE30\uB3C4 \uBC14\uBCF4
      \uAC19\uC544\uC11C \uC548 \uB3C4\uC640\uC8FC\uAE30\uC5D0\uB3C4 \uCC38 \uC548\uC4F0\uB7EC\uC6CC\xB7\xB7\xB7.\r\n\uC774\uB9AC
      \uC640\uBCF4\uC9C0 \uC54A\uC73C\uB828? \uC544\uB2D8, \uADF8\uB0E5 \uAC00\uB2E4
      \uCAD3\uACA8 \uC8FD\uC5B4\uB3C4 \uB418\uACE0."
