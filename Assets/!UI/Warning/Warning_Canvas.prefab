  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBCF8 \uAC8C\uC784\uC5D0\uB294 \uC810\uBA78\uD558\uB294 \uBE5B, \uAC15\uD55C
    \uBA85\uC554 \uB300\uBE44, \uBC18\uBCF5\uC801\uC778 \uC2DC\uAC01 \uD6A8\uACFC
    \uB4F1 \uAD11\uACFC\uBBFC\uC131 \uBC1C\uC791\uC744 \uC720\uBC1C\uD560 \uC218
    \uC788\uB294 \uC694\uC18C\uAC00 \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uB7EC\uD55C
    \uC2DC\uAC01\uC801 \uC790\uADF9\uC740 \uC77C\uBD80 \uC774\uC6A9\uC790\uC5D0\uAC8C
    \uBC1C\uC791\uC774\uB098 \uC2E0\uCCB4\uC801 \uBD88\uD3B8\uC744 \uC720\uBC1C\uD560
    \uC218 \uC788\uC73C\uBA70, \uACFC\uAC70 \uBC1C\uC791 \uB610\uB294 \uB1CC\uC804\uC99D
    \uBCD1\uB825\uC774 \uC5C6\uB294 \uACBD\uC6B0\uC5D0\uB3C4 \uC99D\uC0C1\uC774 \uB098\uD0C0\uB0A0
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC8C\uC784 \uC774\uC6A9 \uC911 \uC5B4\uC9C0\uB7EC\uC6C0,
    \uB450\uD1B5, \uC2DC\uC57C \uC774\uC0C1, \uADFC\uC721 \uACBD\uB828, \uBC29\uD5A5\uAC10\uAC01
    \uC0C1\uC2E4, \uC758\uC2DD \uBCC0\uD654 \uB4F1\uC758 \uC99D\uC0C1\uC774 \uB098\uD0C0\uB0A0
    \uACBD\uC6B0 \uC989\uC2DC \uD50C\uB808\uC774\uB97C \uC911\uB2E8\uD558\uACE0 \uC758\uB8CC\uC9C4\uACFC
    \uC0C1\uB2F4\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\n\uBC1C\uC791 \uB610\uB294
    \uB1CC\uC804\uC99D \uBCD1\uB825\uC774 \uC788\uB294 \uC774\uC6A9\uC790\uB294 \uAC8C\uC784\uC744
    \uC2DC\uC791\uD558\uAE30 \uC804 \uC758\uB8CC\uC9C4\uACFC \uC0C1\uB2F4\uD558\uC2DC\uAE30\uB97C
    \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
