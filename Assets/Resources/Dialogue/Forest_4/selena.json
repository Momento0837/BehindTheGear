{
  "lines": [
    {
      "speaker": "Selena",
      "표정": "기본 표정",
      "text": "왜 절 잡으신 거예요?"
    },
    {
      "speaker": "Ethan",
      "표정": "눈 돌림",
      "text": "······ 저랑 목적이 같아 보여서?"
    },
    {
      "speaker": "Ethan",
      "표정": "기본 표정",
      "text": "저는, 이 바닥을 뒤집어 엎을 겁니다."
    },
    {
      "speaker": "Ethan",
      "표정": "기본 표정",
      "text": "······이를테면 혁명 말이죠."
    },
    {
      "speaker": "Selena",
      "표정": "기본 표정",
      "text": "···진심이에요?"
    },
    {
      "speaker": "Ethan",
      "표정": "의아",
      "text": "거지처럼 보이는 사람이, 당신 보고\n'반동분자' 라고 하더군요."
    },
    {
      "speaker": "Selena",
      "표정": "기본 표정",
      "text": "······."
    },
    {
      "speaker": "Ethan",
      "표정": "곤란",
      "연출": "quest:take_cover",
      "text": "더 할 말 없으시면 따라오세요.\n몸은 일단 피하고 봐야 해서···."
    },
    {
      "speaker": "Selena",
      "표정": "기본 표정",
      "text": "···그러죠."
    }
  ]
}
